  # MODEL selects the icon Finder shows; the choices are pictured in ../README.md.
  - path: /etc/pihero/device-info.conf
    content: MODEL=AirPort4
  # PRODUCT names the gadget on the USB host (the board model if unset); CIDR is the subnet the Pi serves to it.
  - path: /etc/pihero/usb-gadget.conf
    content: |
      PRODUCT="Sample Pi"
      CIDR=10.10.10.10/29
  # Debian's legal notice, the static half of the MOTD; base-files restores it only when the file is missing.
  - path: /etc/motd
    content: ""
runcmd:
  - hostnamectl set-hostname --pretty "Sample Pi"
  - systemctl restart pihero-avahi-render.service
