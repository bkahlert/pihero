#cloud-config
# board: QEMU virt (tier 2)  image: Raspberry Pi OS Lite 64-bit (Trixie)
hostname: all-features
manage_etc_hosts: true
enable_ssh: true
ssh_pwauth: false
users:
  - name: pihero
    groups: users,adm,sudo,gpio,spi,i2c,netdev,plugdev
    shell: /bin/bash
    lock_passwd: true
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJDiuqm2ktQeCoYMDWkft4sJsbpS/OtBezHVULABowbs pihero-testkit
package_update: true
packages:
  - avahi-utils
  - pihero
  - pihero-avahi
write_files:
  - path: /etc/apt/sources.list.d/pihero.sources
    content: |
      Types: deb
      URIs: http://10.0.2.2:8000/
      Suites: ./
      Trusted: yes
  - path: /etc/pihero/device-info.conf
    content: MODEL=MacPro7,1@ECOLOR=226,226,224
runcmd:
  # Request the reboot a feature package would, so provisioning exercises the power_state path.
  - touch /run/reboot-required
  - hostnamectl set-hostname --pretty "All Features"
  - systemctl restart pihero-avahi-render.service
power_state:
  mode: reboot
  condition: test -f /run/reboot-required
