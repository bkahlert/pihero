[Unit]
Description=dnsmasq-based DHCP server for usb0
Requires=network.target
Wants=nss-lookup.target
Before=nss-lookup.target
After=network.target
After=usb-gadget.service
BindsTo=sys-subsystem-net-devices-usb0.device
After=sys-subsystem-net-devices-usb0.device

[Service]
Type=forking
PIDFile=/run/dnsmasq/dnsmasq-usb0.pid
ExecStart=/usr/sbin/dnsmasq --conf-file=/dev/null --pid-file=/run/dnsmasq/dnsmasq-usb0.pid --port=0 --bind-interfaces --interface=usb0 --dhcp-range={{ usb0_cidr_first_usable }},{{ usb0_cidr_last_usable }},{{ usb0_cidr_netmask }},1h --dhcp-authoritative --leasefile-ro
ExecReload=/bin/kill -HUP $MAINPID

[Install]
WantedBy=multi-user.target
