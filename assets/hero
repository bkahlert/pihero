#!/usr/bin/env bash
# Purpose: Render the Pi Hero kaomoji ─=≡▰▩▩[ 蓬•ｏ•]⊐ in all moods, plain or colored, static or animated.
# Usage:   hero [--no-entrance] [--loops <n> [--exit]] [--frame-ms <ms>]
#          hero --mood <mood> [--animate [--no-entrance]] [--color|--no-color] [--loops <n> [--exit]] [--frame-ms <ms>]
#
# Without --mood, all variants are shown in a grid: one row per mood, one column per style.
# With --mood, a single variant is rendered. Colors need a 256-color terminal. Needs bash 4.4+.
#
# Options:
#   --mood <mood>     One of neutral, happy, sad, unknown.
#   --animate         Fly the hero in from the left and let it hover (default: static).
#   --no-entrance     Skip the fly-in and start hovering right away.
#   --color           Colored output (default: if stdout is a terminal and NO_COLOR is unset).
#   --no-color        Plain output.
#   --loops <n>       Stop after <n> hover cycles (default: endless, until Ctrl-C).
#   --exit            Fly the hero out to the right after the last hover cycle (needs --loops).
#   --frame-ms <ms>   Delay between animation frames (default: 50).
#   -h, --help        Show this help.
#
# Examples:
#   hero                                    # grid of all variants, animated until Ctrl-C
#   hero --loops 1                          # grid, hovering once, then exits
#   hero --loops 4 --exit                   # grid, hovering four times, then flying out
#   hero --mood happy
#   ─=≡▰▩▩[✿＾ｖ＾]⊐
#   hero --mood sad --animate --loops 3 --exit
#   hero --mood neutral --animate --no-entrance
#   hero --mood neutral --no-color > motd   # plain text for a file

set -euo pipefail

# Bash slices strings by character only in a UTF-8 locale, and the kaomoji is made of multibyte ones.
case ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} in
*[Uu][Tt][Ff]-8* | *[Uu][Tt][Ff]8*) ;;
*) export LC_ALL=C.UTF-8 ;;
esac

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "${BASH_SOURCE[0]}"; }
die() { printf '%s: %s\nSee '\''%s --help'\''\n' "${0##*/}" "$1" "${0##*/}" >&2; exit 2; }

# 256-color palette of the Pi Hero logo
readonly HERO_ORANGE=214 # #f6b535
readonly HERO_YELLOW=221 # #f7dc38
readonly HERO_PINK=198   # #f80884
readonly HERO_VIOLET=93  # #8a4bd8
readonly HERO_BLUE=62    # #3b4bef
readonly HERO_RED=125    # #b1133b
readonly HERO_BROWN=94   # #974219

readonly -a HERO_MOODS=(neutral happy sad unknown)

# While hovering, the tail cycles through four poses held for three steps each,
# and the hand alternates between two poses held for six steps each.
readonly -a HERO_TAIL_POSES=('-─=' ' -─' '-─=' '─=≡')
readonly -a HERO_HAND_POSES=('⫎' '⊐')
readonly HERO_CYCLE=12
readonly HERO_REST=$((HERO_CYCLE - 1)) # step of the pose at rest: ─=≡ and ⊐

# Terminal capabilities, resolved once: tput is slow enough to make animations stutter.
HERO_COLORS=$(tput colors 2>/dev/null || echo 0)
HERO_SGR0=$(tput sgr0 2>/dev/null || true)
HERO_CIVIS=$(tput civis 2>/dev/null || true)
HERO_CNORM=$(tput cnorm 2>/dev/null || true)
HERO_CUU1=$(tput cuu1 2>/dev/null || true)
HERO_EL=$(tput el 2>/dev/null || true)
readonly HERO_COLORS HERO_SGR0 HERO_CIVIS HERO_CNORM HERO_CUU1 HERO_EL
declare -A HERO_SGR=() # style → escape sequence, filled by hero_sgr_cache

# Fills an array with the hero's graphemes, each as "<style><TAB><text>".
# A style is "<fg>/<bg>" with 256-color indices (either may be empty) or "dim".
#   --mood <mood>   neutral (default), happy, sad or unknown
#   --step <n>      step of the hover cycle, selects the tail and hand pose (default: at rest)
#   <array>         name of the array to fill
hero_sprite() {
    local mood=neutral
    local -i step=$HERO_REST
    while [ $# -gt 0 ]; do
        case $1 in
        --mood) mood=${2?$1: missing value}; shift 2 ;;
        --mood=*) mood=${1#*=}; shift ;;
        --step) step=${2?$1: missing value}; shift 2 ;;
        --step=*) step=${1#*=}; shift ;;
        --) shift; break ;;
        -?*) die "${FUNCNAME[0]}: unknown option: $1" ;;
        *) break ;;
        esac
    done
    local -n target=${1?${FUNCNAME[0]}: array name missing}

    local -a face
    case $mood in
    neutral) face=(' ' '蓬' '•' 'ｏ' '•' '') ;;
    happy) face=('' '✿' '＾' 'ｖ' '＾' '') ;;
    sad) face=(' ' '༶' '◕' '︿' '◕' ' ') ;;
    unknown) face=('' '༶' '´⊙' '﹏' '⊙`' '') ;;
    *) die "unknown mood: $mood" ;;
    esac
    local -a face_fg=(0 "$HERO_RED" 0 "$HERO_PINK" 0 "$HERO_RED")

    local tail=${HERO_TAIL_POSES[step / 3 % ${#HERO_TAIL_POSES[@]}]}
    local hand=${HERO_HAND_POSES[step / 6 % ${#HERO_HAND_POSES[@]}]}
    local -i i
    target=()
    for ((i = 0; i < ${#tail}; i++)); do
        target+=("dim"$'\t'"${tail:i:1}")
    done
    target+=(
        "$HERO_BROWN/$HERO_PINK"$'\t''▰'
        "$HERO_BLUE/$HERO_PINK"$'\t''▩'
        "$HERO_VIOLET/$HERO_PINK"$'\t''▩'
        "$HERO_ORANGE/$HERO_YELLOW"$'\t''['
    )
    for i in "${!face[@]}"; do
        [ -z "${face[i]}" ] || target+=("${face_fg[i]}/$HERO_YELLOW"$'\t'"${face[i]}")
    done
    target+=(
        "$HERO_ORANGE/$HERO_YELLOW"$'\t'']'
        "$HERO_YELLOW/"$'\t'"$hand"
    )
}

# Sets REPLY to the number of terminal cells the given text occupies.
hero_text_width() {
    local text=$1
    local -i i
    REPLY=0
    for ((i = 0; i < ${#text}; i++)); do
        case ${text:i:1} in
        蓬 | ｏ | ＾ | ｖ | ︿ | ﹏) REPLY=$((REPLY + 2)) ;; # East Asian wide
        *) REPLY=$((REPLY + 1)) ;;
        esac
    done
}

# Makes sure HERO_SGR[<style>] holds the escape sequence that starts the style.
# Foreground and background colors need a 256-color terminal and are left out otherwise.
hero_sgr_cache() {
    local style=$1
    [ -z "${HERO_SGR[$style]+set}" ] || return 0
    local seq='' fg bg
    case $style in
    dim) seq=$(tput dim 2>/dev/null || true) ;;
    */*)
        fg=${style%/*}
        bg=${style#*/}
        if [ "$HERO_COLORS" -ge 256 ]; then
            [ -z "$fg" ] || seq+=$(tput setaf "$fg" 2>/dev/null || true)
            [ -z "$bg" ] || seq+=$(tput setab "$bg" 2>/dev/null || true)
        fi
        ;;
    *) die "${FUNCNAME[0]}: unknown style: $style" ;;
    esac
    HERO_SGR[$style]=$seq
}

# Prints the graphemes of a sprite (no trailing newline).
#   --offset <n>   drop <n> graphemes from the left, or pad the left with -<n> spaces if negative (default: 0)
#   --width <n>    pad the right with spaces up to a display width of <n> (default: 0)
#   --clip <n>     drop the graphemes that don't fit into a display width of <n> (default: 0, keep all)
#   --color        apply the styles
#   <array>        name of an array filled by hero_sprite
hero_paint() {
    local -i offset=0 width=0 clip=0 color=0
    while [ $# -gt 0 ]; do
        case $1 in
        --offset) offset=${2?$1: missing value}; shift 2 ;;
        --offset=*) offset=${1#*=}; shift ;;
        --width) width=${2?$1: missing value}; shift 2 ;;
        --width=*) width=${1#*=}; shift ;;
        --clip) clip=${2?$1: missing value}; shift 2 ;;
        --clip=*) clip=${1#*=}; shift ;;
        --color) color=1; shift ;;
        --) shift; break ;;
        -?*) die "${FUNCNAME[0]}: unknown option: $1" ;;
        *) break ;;
        esac
    done
    local -n graphemes=${1?${FUNCNAME[0]}: array name missing}

    local out='' pad style text
    local -i i shown=0
    if ((offset < 0)); then
        printf -v out '%*s' "$((-offset))" ''
        shown=-offset
        offset=0
    fi
    for ((i = offset; i < ${#graphemes[@]}; i++)); do
        style=${graphemes[i]%%$'\t'*}
        text=${graphemes[i]#*$'\t'}
        hero_text_width "$text"
        if ((clip > 0 && shown + REPLY > clip)); then break; fi
        shown+=REPLY
        if ((color)); then
            hero_sgr_cache "$style"
            out+="${HERO_SGR[$style]}$text$HERO_SGR0"
        else
            out+=$text
        fi
    done
    if ((shown < width)); then
        printf -v pad '%*s' "$((width - shown))" ''
        out+=$pad
    fi
    printf '%s' "$out"
}

# Prints one frame of the hero (no trailing newline).
#   --mood <mood>   neutral (default), happy, sad or unknown
#   --step <n>      step of the animation: the hero flies in from the left during the first
#                   steps, one grapheme per step, and hovers afterwards (default: at rest)
#   --no-entrance   hover where the hero lands instead of hopping one cell to the right
#   --exit <n>      step after which the hero flies out to the right, one cell per step; it is
#                   gone as many steps later as it is cells wide (default: never)
#   --width <n>     pad the right with spaces up to this display width (default: 0)
#   --color         colored output
hero_frame() {
    local mood=neutral step='' exit_step=''
    local -i width=0 entrance=1
    local -a color=()
    while [ $# -gt 0 ]; do
        case $1 in
        --mood) mood=${2?$1: missing value}; shift 2 ;;
        --mood=*) mood=${1#*=}; shift ;;
        --step) step=${2?$1: missing value}; shift 2 ;;
        --step=*) step=${1#*=}; shift ;;
        --no-entrance) entrance=0; shift ;;
        --exit) exit_step=${2?$1: missing value}; shift 2 ;;
        --exit=*) exit_step=${1#*=}; shift ;;
        --width) width=${2?$1: missing value}; shift 2 ;;
        --width=*) width=${1#*=}; shift ;;
        --color) color=(--color); shift ;;
        -?*) die "${FUNCNAME[0]}: unknown option: $1" ;;
        *) die "${FUNCNAME[0]}: unexpected argument: $1" ;;
        esac
    done

    local -a sprite
    if [ -z "$step" ]; then
        hero_sprite --mood "$mood" sprite
        hero_paint "${color[@]}" --width "$width" sprite
        return 0
    fi

    hero_sprite --mood "$mood" sprite # only to count the graphemes and measure the width
    local -i size=${#sprite[@]} phase pose offset clip=0
    # The poses are phased so that the hero is at rest once it has fully arrived (step == size)
    # and again after every hover cycle.
    phase=$(((HERO_REST - size % HERO_CYCLE + HERO_CYCLE) % HERO_CYCLE))
    pose=$(((step + phase) % HERO_CYCLE))
    if ((step <= size)); then offset=$((size - step)); else offset=$((entrance ? -1 : 0)); fi
    if [ -n "$exit_step" ] && ((step > exit_step)); then
        # The hero leaves the cells it hovered in and is clipped at their right edge.
        hero_text_width "$(hero_paint sprite)"
        clip=$((REPLY - offset))
        offset=$((offset - (step - exit_step)))
        if ((-offset > clip)); then offset=$((-clip)); fi
    fi
    hero_sprite --mood "$mood" --step "$pose" sprite
    hero_paint "${color[@]}" --offset "$offset" --clip "$clip" --width "$width" sprite
}

# Paces an animation: sleeps for the given number of milliseconds. Every frame but the last
# is followed by a call to this function, which is what hero-gif hooks into.
hero_sleep_ms() {
    local pause
    printf -v pause '%d.%03d' "$(($1 / 1000))" "$(($1 % 1000))"
    sleep "$pause"
}

# Hides the cursor for an animation and brings it back when the script ends, also on Ctrl-C.
hero_animation_begin() {
    trap 'printf "%s" "$HERO_CNORM"' EXIT
    trap 'printf "\n"; exit 130' INT
    printf '%s' "$HERO_CIVIS"
}

hero_animation_end() {
    printf '%s' "$HERO_CNORM"
    trap - EXIT INT
}

# Animates a single hero on the current line and ends it with a newline.
#   --mood <mood>     neutral (default), happy, sad or unknown
#   --color           colored output
#   --no-entrance     skip the fly-in and start hovering right away
#   --loops <n>       stop after <n> hover cycles (default: -1, endless)
#   --exit            fly out to the right after the last hover cycle
#   --frame-ms <ms>   delay between frames (default: 50)
hero_animate() {
    local mood=neutral
    local -a color=() flags=() # flags are passed on to hero_frame
    local -i entrance=1 exit=0 loops=-1 frame_ms=50
    while [ $# -gt 0 ]; do
        case $1 in
        --mood) mood=${2?$1: missing value}; shift 2 ;;
        --mood=*) mood=${1#*=}; shift ;;
        --color) color=(--color); shift ;;
        --no-entrance) entrance=0; flags+=(--no-entrance); shift ;;
        --exit) exit=1; shift ;;
        --loops) loops=${2?$1: missing value}; shift 2 ;;
        --loops=*) loops=${1#*=}; shift ;;
        --frame-ms) frame_ms=${2?$1: missing value}; shift 2 ;;
        --frame-ms=*) frame_ms=${1#*=}; shift ;;
        -?*) die "${FUNCNAME[0]}: unknown option: $1" ;;
        *) die "${FUNCNAME[0]}: unexpected argument: $1" ;;
        esac
    done

    local -a sprite
    hero_sprite --mood "$mood" sprite # only to count the graphemes
    local -i size=${#sprite[@]} first=0 last step
    if ((!entrance)); then first=$((size + 1)); fi # the first hover step
    last=$((size + loops * HERO_CYCLE))            # meaningless while endless
    if ((exit)); then
        flags+=(--exit "$last")
        hero_text_width "$(hero_frame --mood "$mood")"
        last+=REPLY # gone once it has moved its own width to the right
    fi
    hero_animation_begin
    for ((step = first; ; step++)); do
        printf '\r'
        hero_frame --mood "$mood" --step "$step" "${color[@]}" "${flags[@]}"
        printf '%s' "$HERO_EL"
        if ((loops >= 0 && step >= last)); then break; fi
        hero_sleep_ms "$frame_ms"
    done
    printf '\n'
    hero_animation_end
}

# Prints a grid of all variants: one row per mood, one column per style
# (static and animated, each plain and colored). The animated columns play in place.
#   --no-entrance     skip the fly-in and start hovering right away
#   --loops <n>       stop after <n> hover cycles (default: -1, endless)
#   --exit            fly out to the right after the last hover cycle
#   --frame-ms <ms>   delay between frames (default: 50)
hero_grid() {
    local -i entrance=1 exit=0 loops=-1 frame_ms=50
    local -a flags=() # passed on to hero_frame
    while [ $# -gt 0 ]; do
        case $1 in
        --no-entrance) entrance=0; flags=(--no-entrance); shift ;;
        --exit) exit=1; shift ;;
        --loops) loops=${2?$1: missing value}; shift 2 ;;
        --loops=*) loops=${1#*=}; shift ;;
        --frame-ms) frame_ms=${2?$1: missing value}; shift 2 ;;
        --frame-ms=*) frame_ms=${1#*=}; shift ;;
        -?*) die "${FUNCNAME[0]}: unknown option: $1" ;;
        *) die "${FUNCNAME[0]}: unexpected argument: $1" ;;
        esac
    done

    local -a titles=('static plain' 'static color' 'animated plain' 'animated color')
    local dim
    hero_sgr_cache dim
    dim=${HERO_SGR[dim]}

    # The label column fits every mood, a cell fits the widest hero plus the space it hovers in,
    # and each mood's animation runs from its own first to its own last step.
    local -i label=4 cell=0 i size width last=0
    local -a first_step=() exit_step=() last_step=() sprite exit_flags=()
    local mood plain
    for i in "${!HERO_MOODS[@]}"; do
        mood=${HERO_MOODS[i]}
        if ((${#mood} > label)); then label=${#mood}; fi
        plain=$(hero_frame --mood "$mood")
        hero_text_width "$plain"
        width=$REPLY
        if ((width + 1 > cell)); then cell=$((width + 1)); fi
        hero_sprite --mood "$mood" sprite
        size=${#sprite[@]}
        first_step[i]=$((entrance ? 0 : size + 1))
        exit_step[i]=$((size + loops * HERO_CYCLE))          # meaningless while endless
        last_step[i]=$((exit_step[i] + (exit ? width : 0))) # gone once it has moved its own width
        if ((last_step[i] - first_step[i] > last)); then last=$((last_step[i] - first_step[i])); fi
    done

    # The header and the rows are separated by empty lines; all of them are redrawn per step.
    local -i rows=$((1 + 2 * ${#HERO_MOODS[@]})) step s
    local title
    printf '\n'
    hero_animation_begin
    for ((step = 0; ; step++)); do
        if ((step > 0)); then
            for ((i = 0; i < rows; i++)); do printf '%s' "$HERO_CUU1"; done
        fi
        printf '%s%-*s' "$dim" "$label" mood
        for title in "${titles[@]}"; do printf ' %-*s' "$cell" "$title"; done
        printf '%s%s\n' "$HERO_SGR0" "$HERO_EL"
        for i in "${!HERO_MOODS[@]}"; do
            printf '%s\n' "$HERO_EL"
            mood=${HERO_MOODS[i]}
            s=$((first_step[i] + step))
            if ((loops >= 0 && s > last_step[i])); then s=${last_step[i]}; fi
            if ((exit)); then exit_flags=(--exit "${exit_step[i]}"); fi
            printf '%s%-*s%s' "$dim" "$label" "$mood" "$HERO_SGR0"
            printf ' '
            hero_frame --mood "$mood" --width "$cell"
            printf ' '
            hero_frame --mood "$mood" --width "$cell" --color
            printf ' '
            hero_frame --mood "$mood" --width "$cell" --step "$s" "${flags[@]}" "${exit_flags[@]}"
            printf ' '
            hero_frame --mood "$mood" --width "$cell" --step "$s" --color "${flags[@]}" "${exit_flags[@]}"
            printf '%s\n' "$HERO_EL"
        done
        if ((loops >= 0 && step >= last)); then break; fi
        hero_sleep_ms "$frame_ms"
    done
    printf '\n'
    hero_animation_end
}

main() {
    local mood='' use_color=''
    local -a flags=() # passed on to the animation
    local -i animate=0 exit=0 loops=-1 frame_ms=50
    while [ $# -gt 0 ]; do
        case $1 in
        -h | --help) usage; exit 0 ;;
        --mood) mood=${2?--mood: missing value}; shift 2 ;;
        --mood=*) mood=${1#*=}; shift ;;
        --animate) animate=1; shift ;;
        --no-entrance) flags+=(--no-entrance); shift ;;
        --exit) exit=1; flags+=(--exit); shift ;;
        --color) use_color=1; shift ;;
        --no-color) use_color=0; shift ;;
        --loops) loops=${2?--loops: missing value}; shift 2 ;;
        --loops=*) loops=${1#*=}; shift ;;
        --frame-ms) frame_ms=${2?--frame-ms: missing value}; shift 2 ;;
        --frame-ms=*) frame_ms=${1#*=}; shift ;;
        -?*) die "unknown option: $1" ;;
        *) die "unexpected argument: $1" ;;
        esac
    done
    if ((exit && loops < 0)); then die "--exit needs --loops"; fi

    if [ -z "$mood" ]; then
        hero_grid "${flags[@]}" --loops "$loops" --frame-ms "$frame_ms"
        return 0
    fi

    case " ${HERO_MOODS[*]} " in
    *" $mood "*) ;;
    *) die "unknown mood: $mood" ;;
    esac

    if [ -z "$use_color" ]; then
        if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then use_color=1; else use_color=0; fi
    fi
    local -a color_flag=()
    if ((use_color)); then color_flag=(--color); fi

    if ((animate)); then
        hero_animate --mood "$mood" "${color_flag[@]}" "${flags[@]}" --loops "$loops" --frame-ms "$frame_ms"
    else
        hero_frame --mood "$mood" "${color_flag[@]}"
        printf '\n'
    fi
}

# Run only when executed; hero-gif sources this file to reuse its functions.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
