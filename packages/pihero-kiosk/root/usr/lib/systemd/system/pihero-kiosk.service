[Unit]
Description=Pi Hero: the kiosk page on the display
Documentation=https://github.com/bkahlert/pihero
After=network-online.target
Wants=network-online.target
# Skipped, not failed, where there is no display adapter: the container, the VM, a headless board.
ConditionPathExistsGlob=/dev/dri/card*
StartLimitIntervalSec=0

[Service]
User=kiosk
Group=kiosk
SupplementaryGroups=video render input
Environment=URL=file:///usr/share/pihero/kiosk/index.html
EnvironmentFile=-/etc/pihero/kiosk.conf
Environment=XDG_RUNTIME_DIR=/run/pihero-kiosk XDG_CACHE_HOME=/var/cache/pihero-kiosk XDG_DATA_HOME=/var/lib/pihero-kiosk XDG_CONFIG_HOME=/var/lib/pihero-kiosk
RuntimeDirectory=pihero-kiosk
CacheDirectory=pihero-kiosk
StateDirectory=pihero-kiosk
ExecStart=/usr/lib/pihero/kiosk
# cog 0.18 segfaults on SIGTERM while tearing down the DRM output, which would leave the unit failed after a stop;
# it has nothing to flush, and the kernel releases DRM master on exit. systemd counts only SIGHUP, SIGINT, SIGTERM and
# SIGPIPE as clean, so the kill signal is declared a success status too.
KillSignal=SIGKILL
SuccessExitStatus=SIGKILL
Restart=always
RestartSec=5
MemoryMax=300M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
