#!/usr/bin/env bash
# Purpose: Render the Netmon wizard kaomoji (つ◕౪◕)つ─｡ﾟ․☆･*ﾟ in all moods, plain or colored, static or animated.
# Usage:   wizard [--mood <mood>] [--color|--no-color]
#          wizard [--mood <mood>] [--color|--no-color] --animate [--no-entrance] [--loops <n>] [--exit] [--frame-ms <ms>]
#          wizard --preview [--mood <mood>] [--no-entrance] [--loops <n>] [--exit] [--frame-ms <ms>]
#
# Prints one kaomoji, static unless animated. --preview shows all variants instead: a grid with one
# row per mood and one column per style. Colors need a 16-color terminal. Needs bash 5.0+.
#
# The wizard slides in from the left and conjures the magic particle by particle; while hovering,
# the colors run along the particles. On exit the particles vanish from the right and the wizard
# slides out to the left.
#
# Options:
#   --mood <mood>     One of neutral, happy, sad, unknown (default: neutral).
#   --animate         Slide the wizard in from the left and let it hover (default: static). Implied by the options below.
#   --no-entrance     Skip the entrance and start hovering right away.
#   --loops <n>       Stop after <n> hover cycles (default: endless, until stopped with Ctrl-C).
#   --exit            Let the wizard leave after the last hover cycle, or when an endless animation is
#                     stopped with Ctrl-C or SIGTERM; a second Ctrl-C quits at once.
#   --frame-ms <ms>   Delay between animation frames (default: 50).
#   --color           Colored output (default: if stdout is a terminal and NO_COLOR is unset).
#   --no-color        Plain output.
#   --preview         Show all variants in a grid, animated, instead of one kaomoji.
#   -h, --help        Show this help.
#
# Examples:
#   wizard
#   (つ◕౪◕)つ─｡ﾟ․☆･*ﾟ
#   wizard --mood happy
#   (＾∀＾)つ─｡ﾟ․☆･*ﾟ
#   wizard --animate                        # entrance, then hovering until Ctrl-C
#   wizard --animate --exit                 # ... leaving on Ctrl-C
#   wizard --mood sad --loops 3 --exit      # entrance, three hover cycles, exit
#   wizard --no-entrance                    # hovering right away, until Ctrl-C
#   wizard --no-color > motd                # plain text for a file
#   wizard --preview                        # grid of all variants, animated until Ctrl-C
#   wizard --preview --loops 2 --exit       # grid, hovering twice, then leaving

set -euo pipefail

# shellcheck source=kaomoji.bash
. "$(dirname "${BASH_SOURCE[0]}")/kaomoji.bash"

# 16-color palette
readonly WIZARD_GRAY=7
readonly WIZARD_WHITE=15
readonly WIZARD_PINK=9
readonly WIZARD_GREEN=10
readonly WIZARD_YELLOW=11
readonly WIZARD_BLUE=12
readonly WIZARD_CYAN=14

# shellcheck disable=SC2034 # read by kaomoji.bash through a nameref
readonly -a WIZARD_MOODS=(neutral happy sad unknown)

# The magic streams out of the wand: while hovering, its colors move outwards by one particle
# every WIZARD_SHIFT steps and are back where they started after one cycle.
readonly -a WIZARD_MAGIC=('｡' 'ﾟ' '․' '☆' '･' '*' 'ﾟ')
readonly -a WIZARD_MAGIC_COLORS=("$WIZARD_PINK" "$WIZARD_CYAN" "$WIZARD_YELLOW" "$WIZARD_PINK" "$WIZARD_YELLOW" "$WIZARD_GREEN" "$WIZARD_BLUE")
readonly WIZARD_SHIFT=3
readonly WIZARD_CYCLE=$((WIZARD_SHIFT * ${#WIZARD_MAGIC_COLORS[@]}))

# Fills an array with the wizard's graphemes, each as "<style><TAB><text>", see kaomoji_paint.
#   --mood <mood>   neutral (default), happy, sad or unknown
#   --shift <n>     particles by which the colors of the magic have moved outwards (default: 0)
#   <array>         name of the array to fill
wizard_sprite() {
    local mood=neutral
    local -i shift=0
    while [ $# -gt 0 ]; do
        case $1 in
        --mood) mood=${2?$1: missing value}; shift 2 ;;
        --mood=*) mood=${1#*=}; shift ;;
        --shift) shift=${2?$1: missing value}; shift 2 ;;
        --shift=*) shift=${1#*=}; shift ;;
        --) shift; break ;;
        -?*) die "${FUNCNAME[0]}: unknown option: $1" ;;
        *) break ;;
        esac
    done
    local -n target=${1?${FUNCNAME[0]}: array name missing}

    local -a face
    case $mood in
    neutral) face=('つ' '◕' '౪' '◕') ;;
    happy) face=('＾' '∀' '＾') ;;
    sad) face=(' ' '◕' '︿' '◕') ;;
    unknown) face=(' ' '⊙' '﹏' '⊙') ;;
    *) die "unknown mood: $mood" ;;
    esac

    local text
    target=("$WIZARD_GRAY/"$'\t''(')
    for text in "${face[@]}"; do
        target+=("$WIZARD_GRAY/"$'\t'"$text")
    done
    target+=(
        "$WIZARD_GRAY/"$'\t'')'
        "$WIZARD_WHITE/"$'\t''つ'
        "$WIZARD_GRAY/"$'\t''─'
    )
    local -i i n=${#WIZARD_MAGIC_COLORS[@]}
    for ((i = 0; i < ${#WIZARD_MAGIC[@]}; i++)); do
        target+=("${WIZARD_MAGIC_COLORS[((i - shift) % n + n) % n]}/"$'\t'"${WIZARD_MAGIC[i]}")
    done
}

# Fills an array with the wizard's sprite at a step of the animation, built once per pose: the
# colors of the magic move on every WIZARD_SHIFT steps.
#   <mood> <step> <array>
wizard_pose() {
    kaomoji_sprite "$3" wizard_sprite --mood "$1" --shift "$(($2 / WIZARD_SHIFT % ${#WIZARD_MAGIC_COLORS[@]}))"
}

# Renders one frame of the wizard into KAOMOJI_TEXT, its width in cells into KAOMOJI_WIDTH.
#   --mood <mood>   neutral (default), happy, sad or unknown
#   --step <n>      step of the animation: the wizard slides in from the left, one grapheme per
#                   step, then conjures the magic one particle per step, and hovers afterwards
#                   (default: at rest)
#   --no-entrance   accepted for symmetry with the other kaomoji; the wizard hovers where it lands
#   --exit <n>      step after which the magic vanishes, one particle per step from the right, and
#                   the wizard slides out to the left, one grapheme per step (default: never)
#   --color         colored output
wizard_frame() {
    local mood=neutral step='' exit_step=''
    local -a color=()
    while [ $# -gt 0 ]; do
        case $1 in
        --mood) mood=${2?$1: missing value}; shift 2 ;;
        --mood=*) mood=${1#*=}; shift ;;
        --step) step=${2?$1: missing value}; shift 2 ;;
        --step=*) step=${1#*=}; shift ;;
        --no-entrance) shift ;;
        --exit) exit_step=${2?$1: missing value}; shift 2 ;;
        --exit=*) exit_step=${1#*=}; shift ;;
        --color) color=(--color); shift ;;
        -?*) die "${FUNCNAME[0]}: unknown option: $1" ;;
        *) die "${FUNCNAME[0]}: unexpected argument: $1" ;;
        esac
    done

    local -a sprite
    if [ -z "$step" ]; then
        wizard_pose "$mood" 0 sprite
        kaomoji_paint "${color[@]}" sprite
        return 0
    fi

    local -a timeline
    kaomoji_timeline wizard "$mood" timeline
    local -i magic=${#WIZARD_MAGIC[@]} offset=0 gone
    local -i body=$((timeline[0] - magic))
    local -i shown=$magic
    if ((step <= body)); then
        offset=$((body - step))
        shown=0
    elif ((step < body + magic)); then
        shown=$((step - body))
    fi
    if [ -n "$exit_step" ] && ((step > exit_step)); then
        gone=$((step - exit_step))
        if ((gone <= magic)); then
            shown=$((magic - gone))
        else
            shown=0
            offset=$((gone - magic))
        fi
    fi
    wizard_pose "$mood" "$step" sprite
    kaomoji_paint "${color[@]}" --offset "$offset" --count "$((body + shown - offset))" sprite
}

# Fills an array with the steps of the wizard's entrance (one per grapheme), of one hover cycle,
# and of its exit (one per grapheme), see kaomoji.bash.
#   --mood <mood>   neutral (default), happy, sad or unknown
#   <array>         name of the array to fill
wizard_timeline() {
    local mood=neutral
    while [ $# -gt 0 ]; do
        case $1 in
        --mood) mood=${2?$1: missing value}; shift 2 ;;
        --mood=*) mood=${1#*=}; shift ;;
        --) shift; break ;;
        -?*) die "${FUNCNAME[0]}: unknown option: $1" ;;
        *) break ;;
        esac
    done
    local -n out=${1?${FUNCNAME[0]}: array name missing}
    local -a sprite
    wizard_pose "$mood" 0 sprite
    out=("${#sprite[@]}" "$WIZARD_CYCLE" "${#sprite[@]}")
}

# Run only when executed; kaomoji-gif sources this file to reuse its functions.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    kaomoji_main wizard "$@"
fi
