#!/usr/bin/env bash
# Purpose: Render the Pi Hero kaomoji ─=≡▰▩▩[ 蓬•ｏ•]⊐ in all moods, plain or colored, static or animated.
# Usage:   hero [--mood <mood>] [--color|--no-color]
#          hero [--mood <mood>] [--color|--no-color] --animate [--no-entrance] [--loops <n>] [--exit] [--frame-ms <ms>]
#          hero --preview [--mood <mood>] [--no-entrance] [--loops <n>] [--exit] [--frame-ms <ms>]
#
# Prints one kaomoji, static unless animated. --preview shows all variants instead: a grid with one
# row per mood and one column per style. Colors need a 256-color terminal. Needs bash 5.0+.
#
# The hero flies in from the left and hovers, tail flickering and hand flexing; on exit it flies
# out through the right edge of the terminal, in the same time however wide the terminal is.
#
# Options:
#   --mood <mood>     One of neutral, happy, sad, unknown (default: neutral).
#   --animate         Fly the hero in from the left and let it hover (default: static). Implied by the options below.
#   --no-entrance     Skip the entrance and start hovering right away.
#   --loops <n>       Stop after <n> hover cycles (default: endless, until stopped with Ctrl-C).
#   --exit            Fly the hero out through the terminal's right edge after the last hover cycle, or when an
#                     endless animation is stopped with Ctrl-C or SIGTERM; a second Ctrl-C quits at once.
#   --frame-ms <ms>   Delay between animation frames (default: 50).
#   --color           Colored output (default: if stdout is a terminal and NO_COLOR is unset).
#   --no-color        Plain output.
#   --preview         Show all variants in a grid, animated, instead of one kaomoji.
#   -h, --help        Show this help.
#
# Examples:
#   hero
#   ─=≡▰▩▩[ 蓬•ｏ•]⊐
#   hero --mood happy
#   ─=≡▰▩▩[✿＾ｖ＾]⊐
#   hero --animate                        # entrance, then hovering until Ctrl-C
#   hero --animate --exit                 # ... leaving on Ctrl-C
#   hero --mood sad --loops 3 --exit      # entrance, three hover cycles, exit
#   hero --no-entrance                    # hovering right away, until Ctrl-C
#   hero --no-color > motd                # plain text for a file
#   hero --preview                        # grid of all variants, animated until Ctrl-C
#   hero --preview --loops 2 --exit       # grid, hovering twice, then leaving

set -euo pipefail

# The engine sits next to the face in the checkout, and in /usr/lib/kaomoji once installed.
KAOMOJI_ENGINE=${BASH_SOURCE[0]%/*}/kaomoji.bash
[ -e "$KAOMOJI_ENGINE" ] || KAOMOJI_ENGINE=/usr/lib/kaomoji/kaomoji.bash
# shellcheck source=kaomoji.bash
. "$KAOMOJI_ENGINE"

# 256-color palette of the Pi Hero logo
readonly HERO_ORANGE=214 # #f6b535
readonly HERO_YELLOW=221 # #f7dc38
readonly HERO_PINK=198   # #f80884
readonly HERO_VIOLET=93  # #8a4bd8
readonly HERO_BLUE=62    # #3b4bef
readonly HERO_RED=125    # #b1133b
readonly HERO_BROWN=94   # #974219

# shellcheck disable=SC2034 # read by kaomoji.bash through a nameref
readonly -a HERO_MOODS=(neutral happy sad unknown)

# While hovering, the tail cycles through four poses held for three steps each,
# and the hand alternates between two poses held for six steps each.
readonly -a HERO_TAIL_POSES=('-─=' ' -─' '-─=' '─=≡')
readonly -a HERO_HAND_POSES=('⫎' '⊐')
readonly HERO_CYCLE=12
readonly HERO_REST=$((HERO_CYCLE - 1)) # step of the pose at rest: ─=≡ and ⊐

# Fills an array with the hero's graphemes, each as "<style><TAB><text>", see kaomoji_paint.
#   --mood <mood>   neutral (default), happy, sad or unknown
#   --tail <i>      index of the tail pose (default: the last, at rest)
#   --hand <i>      index of the hand pose (default: the last, at rest)
#   <array>         name of the array to fill
hero_sprite() {
    local mood=neutral
    local -i tail=$((${#HERO_TAIL_POSES[@]} - 1)) hand=$((${#HERO_HAND_POSES[@]} - 1))
    while [ $# -gt 0 ]; do
        case $1 in
        --mood) mood=${2?$1: missing value}; shift 2 ;;
        --mood=*) mood=${1#*=}; shift ;;
        --tail) tail=${2?$1: missing value}; shift 2 ;;
        --tail=*) tail=${1#*=}; shift ;;
        --hand) hand=${2?$1: missing value}; shift 2 ;;
        --hand=*) hand=${1#*=}; shift ;;
        --) shift; break ;;
        -?*) die "${FUNCNAME[0]}: unknown option: $1" ;;
        *) break ;;
        esac
    done
    local -n target=${1?${FUNCNAME[0]}: array name missing}

    local -a face
    case $mood in
    neutral) face=(' ' '蓬' '•' 'ｏ' '•' '') ;;
    happy) face=('' '✿' '＾' 'ｖ' '＾' '') ;;
    sad) face=(' ' '༶' '◕' '︿' '◕' ' ') ;;
    unknown) face=('' '༶' '´⊙' '﹏' '⊙`' '') ;;
    *) die "unknown mood: $mood" ;;
    esac
    local -a face_fg=(0 "$HERO_RED" 0 "$HERO_PINK" 0 "$HERO_RED")

    local text=${HERO_TAIL_POSES[tail]}
    local -i i
    target=()
    for ((i = 0; i < ${#text}; i++)); do
        target+=("dim"$'\t'"${text:i:1}")
    done
    target+=(
        "$HERO_BROWN/$HERO_PINK"$'\t''▰'
        "$HERO_BLUE/$HERO_PINK"$'\t''▩'
        "$HERO_VIOLET/$HERO_PINK"$'\t''▩'
        "$HERO_ORANGE/$HERO_YELLOW"$'\t''['
    )
    for i in "${!face[@]}"; do
        [ -z "${face[i]}" ] || target+=("${face_fg[i]}/$HERO_YELLOW"$'\t'"${face[i]}")
    done
    target+=(
        "$HERO_ORANGE/$HERO_YELLOW"$'\t'']'
        "$HERO_YELLOW/"$'\t'"${HERO_HAND_POSES[hand]}"
    )
}

# Fills an array with the hero's sprite at a step of the hover cycle, built once per pose: the
# tail changes every three steps, the hand every six.
#   <mood> <step> <array>
hero_pose() {
    local -i step=$2
    kaomoji_sprite "$3" hero_sprite --mood "$1" \
        --tail "$((step / 3 % ${#HERO_TAIL_POSES[@]}))" --hand "$((step / 6 % ${#HERO_HAND_POSES[@]}))"
}

# Renders one frame of the hero into KAOMOJI_TEXT, its width in cells into KAOMOJI_WIDTH.
#   --mood <mood>   neutral (default), happy, sad or unknown
#   --step <n>      step of the animation: the hero flies in from the left during the first
#                   steps, one grapheme per step, and hovers afterwards (default: at rest)
#   --no-entrance   accepted for symmetry with the other kaomoji; the hero hovers where it lands
#   --exit <n>      step after which the hero flies out to the right, crossing its line
#                   (KAOMOJI_COLUMNS cells, or its own width without one) in as many steps as it
#                   is cells wide and clipped at the line's edge; it is gone after the last of
#                   them (default: never)
#   --color         colored output
hero_frame() {
    local mood=neutral step='' exit_step=''
    local -a color=()
    while [ $# -gt 0 ]; do
        case $1 in
        --mood) mood=${2?$1: missing value}; shift 2 ;;
        --mood=*) mood=${1#*=}; shift ;;
        --step) step=${2?$1: missing value}; shift 2 ;;
        --step=*) step=${1#*=}; shift ;;
        --no-entrance) shift ;;
        --exit) exit_step=${2?$1: missing value}; shift 2 ;;
        --exit=*) exit_step=${1#*=}; shift ;;
        --color) color=(--color); shift ;;
        -?*) die "${FUNCNAME[0]}: unknown option: $1" ;;
        *) die "${FUNCNAME[0]}: unexpected argument: $1" ;;
        esac
    done

    local -a sprite timeline
    local -i pose=$HERO_REST offset=0 clip=0 size phase line
    if [ -n "$step" ]; then
        kaomoji_timeline hero "$mood" timeline # the graphemes and the width of the hero at rest
        size=${timeline[0]}
        # The poses are phased so that the hero is at rest once it has fully arrived (step == size)
        # and again after every hover cycle.
        phase=$(((HERO_REST - size % HERO_CYCLE + HERO_CYCLE) % HERO_CYCLE))
        pose=$(((step + phase) % HERO_CYCLE))
        if ((step <= size)); then offset=$((size - step)); fi
        if [ -n "$exit_step" ] && ((step > exit_step)); then
            # The exit crosses the line in the exit steps, as many as the hero is wide, so that it
            # takes the same time on every terminal. Clipped at the line's edge, less what the hero
            # had still to enter, it is gone after the last step.
            line=${KAOMOJI_COLUMNS:-0}
            ((line > 0)) || line=${timeline[2]}
            clip=$((line - offset))
            offset=$((offset - (step - exit_step) * line / timeline[2]))
            if ((-offset > clip)); then offset=$((-clip)); fi
        fi
    fi
    hero_pose "$mood" "$pose" sprite
    kaomoji_paint "${color[@]}" --offset "$offset" --clip "$clip" sprite
}

# Fills an array with the steps of the hero's entrance (one per grapheme), of one hover cycle,
# and of its exit (one per cell of its width, however wide its line), see kaomoji.bash.
#   --mood <mood>   neutral (default), happy, sad or unknown
#   <array>         name of the array to fill
hero_timeline() {
    local mood=neutral
    while [ $# -gt 0 ]; do
        case $1 in
        --mood) mood=${2?$1: missing value}; shift 2 ;;
        --mood=*) mood=${1#*=}; shift ;;
        --) shift; break ;;
        -?*) die "${FUNCNAME[0]}: unknown option: $1" ;;
        *) break ;;
        esac
    done
    local -n out=${1?${FUNCNAME[0]}: array name missing}
    local -a sprite
    hero_pose "$mood" "$HERO_REST" sprite
    kaomoji_paint sprite
    out=("${#sprite[@]}" "$HERO_CYCLE" "$KAOMOJI_WIDTH")
}

# Run only when executed; kaomoji-gif sources this file to reuse its functions.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    kaomoji_main hero "$@"
fi
